# EPOCH runs without credentials. It reads these from the environment (no .env loader); all are optional.

# API server (pnpm api / pnpm dev)
PORT=3000
HOST=127.0.0.1
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Where EPOCH keeps its state
EPOCH_DB_PATH=data/epoch.db
EPOCH_WORK_DIR=.epoch
# EPOCH_SAMPLE_REPO=.epoch/sample-repo

# Hosting: serve the built console from the API and run the guarded public demo
# EPOCH_CONSOLE_DIR=dist
# EPOCH_PUBLIC_DEMO=1
# EPOCH_SHOWCASE_SNAPSHOT=.showcase
# EPOCH_DEMO_RESTORE_MINUTES=20
# EPOCH_TEST_CONCURRENCY=2

# EPOCH-MCP (started by IBM Bob from .bob/mcp.json)
EPOCH_API_URL=http://127.0.0.1:3000
EPOCH_MCP_AUTHOR=IBM Bob
