{
  "name": "epoch",
  "version": "0.4.0",
  "description": "AI-native control and intelligence plane for software that never stops changing",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently --names API,UI --prefix-colors blue,green \"pnpm api:dev\" \"pnpm console:dev\"",
    "api": "tsx src/api/server.ts",
    "start": "node --import tsx src/api/server.ts",
    "api:dev": "tsx watch src/api/server.ts",
    "mcp": "node scripts/epoch-mcp.mjs",
    "console:dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.console.json && pnpm --filter @epoch/sample-app typecheck",
    "test": "vitest --run",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:e2e": "vitest --run tests/e2e",
    "seed": "tsx scripts/seed.ts",
    "migrate": "tsx scripts/migrate.ts",
    "demo-reset": "tsx scripts/demo-reset.ts",
    "demo:replay": "tsx scripts/demo-replay.ts",
    "demo:futures": "tsx scripts/demo-futures.ts",
    "report": "tsx scripts/report.ts",
    "showcase:snapshot": "tsx scripts/showcase-snapshot.ts",
    "verify:clone": "node scripts/verify-clone.mjs",
    "check": "pnpm verify:clone && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write src docs scripts"
  },
  "dependencies": {
    "@hono/node-server": "1.13.7",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "11.9.1",
    "hono": "4.7.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nanoid": "5.0.9",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.15.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "4.4.1",
    "concurrently": "9.1.2",
    "prettier": "3.5.3",
    "tailwindcss": "^4.3.3",
    "tsx": "4.19.3",
    "typescript": "5.5.4",
    "vite": "6.3.5",
    "vitest": "3.1.4"
  }
}
