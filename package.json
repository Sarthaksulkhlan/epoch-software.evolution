{
  "name": "epoch",
  "version": "0.3.0",
  "description": "AI-native control and intelligence plane for software that never stops changing",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently --names \"API,MCP,UI\" --prefix-colors \"blue,cyan,green\" \"pnpm api:dev\" \"pnpm mcp:dev\" \"pnpm console:dev\"",
    "api:dev": "tsx watch src/api/server.ts",
    "mcp:dev": "tsx watch src/api/mcp/mcp-server.ts",
    "console:dev": "vite src/console",
    "build": "tsc -p tsconfig.json && vite build src/console",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:e2e": "vitest --run tests/e2e",
    "seed": "tsx scripts/seed.ts",
    "migrate": "tsx scripts/migrate.ts",
    "demo-reset": "tsx scripts/demo-reset.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src docs scripts"
  },
  "dependencies": {
    "@hono/node-server": "1.13.7",
    "better-sqlite3": "11.9.1",
    "eventemitter3": "5.0.1",
    "hono": "4.7.9",
    "nanoid": "5.0.9",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.15.21",
    "@vitejs/plugin-react": "4.4.1",
    "concurrently": "9.1.2",
    "eslint": "9.26.0",
    "prettier": "3.5.3",
    "tsx": "4.19.3",
    "typescript": "5.5.4",
    "vite": "6.3.5",
    "vitest": "3.1.4"
  }
}
