{
  "name": "epoch",
  "version": "0.4.0",
  "description": "AI-native control and intelligence plane for software that never stops changing",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently --names API,UI --prefix-colors blue,green \"pnpm api:dev\" \"pnpm console:dev\"",
    "api": "tsx src/api/server.ts",
    "api:dev": "tsx watch src/api/server.ts",
    "mcp": "node --import tsx src/api/mcp/mcp-server.ts",
    "console:dev": "vite --config src/console/vite.config.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @epoch/sample-app typecheck",
    "test": "vitest --run",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:e2e": "vitest --run tests/e2e",
    "seed": "tsx scripts/seed.ts",
    "migrate": "tsx scripts/migrate.ts",
    "demo-reset": "tsx scripts/demo-reset.ts",
    "demo:replay": "tsx scripts/demo-replay.ts",
    "demo:futures": "tsx scripts/demo-futures.ts",
    "format": "prettier --write src docs scripts"
  },
  "dependencies": {
    "@hono/node-server": "1.13.7",
    "@modelcontextprotocol/sdk": "1.30.1",
    "better-sqlite3": "11.9.1",
    "eventemitter3": "5.0.1",
    "hono": "4.7.9",
    "nanoid": "5.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.15.21",
    "@vitejs/plugin-react": "4.4.1",
    "concurrently": "9.1.2",
    "eslint": "9.26.0",
    "prettier": "3.5.3",
    "tsx": "4.19.3",
    "typescript": "5.5.4",
    "vite": "6.3.5",
    "vitest": "3.1.4"
  }
}
